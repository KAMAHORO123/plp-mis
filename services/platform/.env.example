DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/plp_development
APP_ORIGIN=http://localhost:5175
NODE_ENV=development
PORT=8082
CREDENTIAL_URL=http://127.0.0.1:8083
UPLOAD_DIR=./uploads
# Only enable behind the included gateway; the API port must never be published.
TRUST_PROXY=false

# Google OAuth: Web application, callback APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password recovery: enable the mail worker after configuring SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Mentorship request emails may only be sent to these mentor mailbox domains (comma separated)
MENTOR_EMAIL_DOMAINS=peaceloveproclaimers.org
