# Generate with: openssl rand -hex 32
# Hex avoids URL escaping in DATABASE_URL. Never commit the real file.
DB_PASSWORD=
APP_DB_PASSWORD=
# Two distinct public DNS names pointing to the server. No https:// or trailing slash.
SITE_HOST=
HUB_HOST=
TLS_EMAIL=

# Google OAuth: Web application, callback APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email codes (password recovery, verification): enable the mail worker after configuring SMTP.
# Google Workspace SMTP relay: SMTP_HOST=smtp-relay.gmail.com, SMTP_PORT=587.
#   IP-authorised rule (recommended on the server): leave SMTP_USER and SMTP_PASSWORD empty.
#   SMTP-authentication rule: SMTP_USER=info@your-domain, SMTP_PASSWORD=<Google app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional: name sent in EHLO; defaults to the MAIL_FROM domain.
SMTP_HELO_NAME=
# Session signing key (JWT). Generate with: openssl rand -base64 48
JWT_SECRET=
# Optional, during a key rotation: the previous key, still accepted until sessions expire.
JWT_SECRET_PREVIOUS=
