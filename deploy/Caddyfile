{
 email {$TLS_EMAIL}
}
{$SITE_HOST} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  X-Frame-Options DENY
  Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # The public site loads only its own files, Google Fonts and the public API on this same address.
  Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  -Server
 }
 # Live quiz players can type the short address plpyouth.org/play; the game itself runs in the Hub.
 @play path /play /play/*
 redir @play https://{$HUB_HOST}{uri} 302
 # Public read-only API (announcement, welcome popup, fun corner) the website loads, as in the local setup.
 handle /api/public/* {
  reverse_proxy platform:8082 {
   header_up X-Real-IP {remote_host}
  }
 }
 handle_path /content/* {
  reverse_proxy content:8080
 }
 handle {
  reverse_proxy landing:80
 }
}
www.{$SITE_HOST} {
 redir https://{$SITE_HOST}{uri} permanent
}
{$HUB_HOST} {
 # Lesson videos and photos are already compressed and must keep byte ranges intact; the live stream must not be buffered.
 @compressible not path /api/files/* /api/avatars/* /api/live
 encode @compressible zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  X-Frame-Options DENY
  -Server
  # The Hub is for signed-in members; keep it out of search results (the public website is plpyouth.org).
  X-Robots-Tag "noindex, nofollow"
  # Camera for proctored assessments, location for meeting check-in, full screen for exams and YouTube lessons.
  Permissions-Policy "camera=(self), microphone=(), geolocation=(self), fullscreen=(self \"https://www.youtube-nocookie.com\")"
  # HTTPS only for a year, and a strict content policy: scripts from this site only, YouTube's no-cookie player,
  # Google Fonts; inline styles are allowed because charts set them. Tested against every page in a browser.
  Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'"
 }
 handle /api/* {
  reverse_proxy platform:8082 {
   header_up X-Real-IP {remote_host}
  }
 }
 handle {
  reverse_proxy hub:80
 }
}
